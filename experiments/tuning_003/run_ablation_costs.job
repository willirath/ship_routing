#!/usr/bin/env bash
#SBATCH --job-name=ablation-costs-003
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=20G
#SBATCH --time=12:00:00
#SBATCH --partition=base
#SBATCH --output=slurm_logs/ablation_costs_%j.out
#SBATCH --error=slurm_logs/ablation_costs_%j.err

# Load compiler environment
module load gcc12-env

# Configure HTTP proxy
export http_proxy=http://10.0.7.235:3128
export https_proxy=http://10.0.7.235:3128
export ftp_proxy=http://10.0.7.235:3128
export HTTP_PROXY=http://10.0.7.235:3128
export HTTPS_PROXY=http://10.0.7.235:3128
export FTP_PROXY=http://10.0.7.235:3128

# Initialize Pixi environment
eval "$(pixi shell-hook)"

for result_file in results/results_ablation_*.msgpack; do
    # Skip already-processed files
    if [[ "$result_file" == *"_with_crosseval.msgpack" ]]; then
        continue
    fi

    python compute_ablation_costs.py "$result_file"
done
