#!/bin/bash
#SBATCH --job-name=ablation-costs-003
#SBATCH --ntasks=52
#SBATCH --cpus-per-task=2
#SBATCH --mem-per-cpu=10G
#SBATCH --time=24:00:00
#SBATCH --partition=base
#SBATCH --output=slurm_logs/ablation_costs_%j.out
#SBATCH --error=slurm_logs/ablation_costs_%j.err

# Configure HTTP proxy
export http_proxy=http://10.0.7.235:3128
export https_proxy=http://10.0.7.235:3128
export HTTP_PROXY=http://10.0.7.235:3128
export HTTPS_PROXY=http://10.0.7.235:3128

# Absolute paths
RESULTS_DIR="${PWD}/results"
SCRIPT_PATH="${PWD}/compute_ablation_costs.py"

{
for result_file in "${RESULTS_DIR}"/results_ablation_*.msgpack; do
    # Skip already-processed files
    if [[ "$result_file" == *"_with_crosseval.msgpack" ]]; then
        continue
    fi

    echo "srun --ntasks=1 --cpus-per-task=2 --exclusive \
        pixi run --no-install --frozen \
        python ${SCRIPT_PATH} ${result_file}"
done
} | xargs -P "$SLURM_NTASKS" -I CMD bash -c "CMD"

jobinfo
