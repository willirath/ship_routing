#!/usr/bin/env bash
#SBATCH --job-name=decompose-021
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=20G
#SBATCH --time=04:00:00
#SBATCH --partition=base
#SBATCH --output=slurm_logs/decompose_%j.out
#SBATCH --error=slurm_logs/decompose_%j.err

# Load compiler environment
module load gcc12-env

# Configure HTTP proxy
export http_proxy=http://10.0.7.235:3128
export https_proxy=http://10.0.7.235:3128
export ftp_proxy=http://10.0.7.235:3128
export HTTP_PROXY=http://10.0.7.235:3128
export HTTPS_PROXY=http://10.0.7.235:3128
export FTP_PROXY=http://10.0.7.235:3128

# Initialize Pixi environment
eval "$(pixi shell-hook)"

# Execute notebook
cd notebooks
jupyter nbconvert --to notebook --execute \
    --ExecutePreprocessor.timeout=14400 \
    --output executed/021_compute_decomposed_costs.ipynb \
    021_compute_decomposed_costs.ipynb
